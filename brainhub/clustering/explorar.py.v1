"""Clustering con K-Means casero (sin sklearn).

Implementado con numpy puro para funcionar en Termux sin compilar.
"""
import json
import subprocess
import os
from pathlib import Path
from collections import Counter
import numpy as np

RAIZ = Path(__file__).resolve().parent.parent.parent
DB_PATH = os.environ.get('BRAINHUB_DB', str(RAIZ / "data" / "analisis_consolidado.duckdb"))


def cargar_documentos():
    """Carga términos por documento desde DuckDB."""
    sql = """
    SELECT video as doc, term, SUM(frequency) as freq
    FROM terminos_raw
    GROUP BY video, term
    """
    result = subprocess.run(
        ['duckdb', DB_PATH, '-json', '-c', sql],
        capture_output=True, text=True, timeout=60
    )
    return json.loads(result.stdout)


def vectorizar_tfidf(filas):
    """Vectoriza documentos con TF-IDF casero."""
    # 1. Agrupar términos por documento
    docs = {}
    for fila in filas:
        doc = fila['doc']
        term = fila['term']
        freq = fila['freq']
        docs.setdefault(doc, Counter())[term] = int(freq)
    
    doc_ids = list(docs.keys())
    n_docs = len(doc_ids)
    
    # 2. Vocabulario global
    vocab = {}
    df = Counter()  # document frequency
    for d in docs.values():
        for term in d:
            df[term] += 1
            if term not in vocab:
                vocab[term] = len(vocab)
    
    # 3. TF-IDF matrix
    n_terms = len(vocab)
    X = np.zeros((n_docs, n_terms))
    
    for i, doc_id in enumerate(doc_ids):
        for term, freq in docs[doc_id].items():
            j = vocab[term]
            tf = 1 + np.log(freq)  # log-tf
            idf = np.log(n_docs / (1 + df[term]))  # idf suavizado
            X[i, j] = tf * idf
    
    # 4. Normalizar L2
    normas = np.linalg.norm(X, axis=1, keepdims=True)
    normas[normas == 0] = 1
    X = X / normas
    
    # Invertir vocab
    inv_vocab = {v: k for k, v in vocab.items()}
    
    return doc_ids, X, inv_vocab


def kmeans_casero(X, k, max_iter=100, seed=42):
    """K-Means implementado con numpy."""
    np.random.seed(seed)
    n_docs = X.shape[0]
    
    # 1. Inicialización: k-means++ simplificado
    idx = np.random.choice(n_docs, k, replace=False)
    centroides = X[idx].copy()
    
    labels_prev = None
    for it in range(max_iter):
        # 2. Asignar cada doc al centroide más cercano
        # Distancias: (n_docs, k)
        distancias = np.linalg.norm(X[:, None, :] - centroides[None, :, :], axis=2)
        labels = np.argmin(distancias, axis=1)
        
        # 3. Convergencia
        if labels_prev is not None and np.array_equal(labels, labels_prev):
            print(f"  Convergió en iteración {it + 1}")
            break
        labels_prev = labels.copy()
        
        # 4. Recalcular centroides
        for i in range(k):
            mask = labels == i
            if mask.any():
                centroides[i] = X[mask].mean(axis=0)
    
    # 5. Inercia (suma de distancias al centroide)
    inercia = sum(
        np.linalg.norm(X[j] - centroides[labels[j]])**2
        for j in range(n_docs)
    )
    
    return labels, centroides, inercia


def silhouette_casero(X, labels):
    """Silhouette score (simplificado)."""
    n = len(X)
    if len(set(labels)) < 2:
        return 0.0
    
    # Distancias todos contra todos (n x n)
    dist = np.linalg.norm(X[:, None, :] - X[None, :, :], axis=2)
    
    sil = []
    for i in range(n):
        mismo = (labels == labels[i])
        mismo[i] = False
        a = dist[i][mismo].mean() if mismo.any() else 0
        
        b = float('inf')
        for c in set(labels):
            if c == labels[i]:
                continue
            otros = (labels == c)
            if otros.any():
                b = min(b, dist[i][otros].mean())
        
        if max(a, b) > 0:
            sil.append((b - a) / max(a, b))
    
    return np.mean(sil) if sil else 0.0


def top_terminos_por_cluster(centroides, inv_vocab, labels, top_n=8):
    """Top términos por cluster."""
    resultado = {}
    k = centroides.shape[0]
    for i in range(k):
        top_idx = centroides[i].argsort()[::-1][:top_n]
        terminos = [inv_vocab.get(int(j), '?') for j in top_idx]
        n_docs = (labels == i).sum()
        resultado[i] = {'n_docs': int(n_docs), 'terminos': terminos}
    return resultado


def explorar(k=8):
    print(f"📊 Cargando documentos de: {DB_PATH}")
    filas = cargar_documentos()
    print(f"   {len(filas)} filas")
    print()
    
    doc_ids, X, inv_vocab = vectorizar_tfidf(filas)
    print(f"📐 Matriz: {X.shape[0]} docs × {X.shape[1]} términos")
    print()
    
    print(f"🔍 Ejecutando K-Means (k={k})...")
    labels, centroides, inercia = kmeans_casero(X, k)
    print(f"   Inercia: {inercia:.3f}")
    print()
    
    sil = silhouette_casero(X, labels)
    print(f"📈 Silhouette score: {sil:.3f}")
    if sil > 0.5:
        print(f"   ✅ Clusters bien separados")
    elif sil > 0.25:
        print(f"   🟡 Separación moderada")
    else:
        print(f"   ⚠️  Clusters solapados")
    print()
    
    print(f"🎯 Top términos por cluster:")
    terminos = top_terminos_por_cluster(centroides, inv_vocab, labels)
    for i, info in terminos.items():
        print(f"\n  Cluster {i} ({info['n_docs']} docs):")
        print(f"    {', '.join(info['terminos'])}")
    
    print()
    print(f"📊 Distribución:")
    for c, n in sorted(Counter(labels).items()):
        print(f"   Cluster {c}: {n} docs")


if __name__ == "__main__":
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument('--k', type=int, default=8, help='Número de clusters')
    args = parser.parse_args()
    explorar(args.k)
